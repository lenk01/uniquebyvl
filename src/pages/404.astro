---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found">
  <section class="view"><div class="wrap">
    <span class="eyebrow">404</span>
    <h1 style="font-size:clamp(34px,6vw,64px);margin:12px 0 18px">Nothing here</h1>
    <p class="lead" style="margin-bottom:24px">This page does not exist, or the piece has found its owner.</p>
    <a class="btn" href="/en/collection/">See the collection</a>
  </div></section>
</Base>
