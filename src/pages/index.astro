---
// Root: send visitors to their language, English by default.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>UNIQUE By VL</title>
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content="0; url=/en/" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <script is:inline>
    (function () {
      var l = (navigator.language || 'en').slice(0, 2).toLowerCase();
      location.replace('/' + (l === 'fr' || l === 'cs' ? l : 'en') + '/');
    })();
  </script>
</head>
<body><a href="/en/">UNIQUE By VL</a></body>
</html>
